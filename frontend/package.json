{
  "name": "ebike-smart-charging-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5195 --strictPort",
    "build": "vite build",
    "dev:pages": "vite --mode pages --host 127.0.0.1 --port 5207 --strictPort",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 5207 --strictPort",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview --host 127.0.0.1 --port 5195 --strictPort",
    "dev:connected": "vite --mode connected --host 127.0.0.1 --port 5201 --strictPort",
    "build:connected": "vite build --mode connected",
    "lint": "eslint src tests vite.config.js eslint.config.js --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint:clients": "cd .. && node frontend/node_modules/eslint/bin/eslint.js mobile-client/src uni-app/src --max-warnings 0",
    "format": "prettier --write src tests vite.config.js eslint.config.js package.json",
    "format:check": "prettier --check src tests vite.config.js eslint.config.js package.json",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "echarts": "5.6.0",
    "qrcode": "1.5.4",
    "three": "0.160.1",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-vue": "5.2.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "vite": "6.0.5"
  },
  "description": "Smart E-Bike Charging Management System - Administration Web Client"
}
